# Real providers for production. Edited by people (like identity.env); the credentials themselves are in
# Secret Manager (ringsays-sms-api-key, ringsays-apns-private-key). RINGSAYS_FCM_PROJECT_ID comes from
# OpenTofu (config.env). Example values: replace before the first production release.
#
# SMS: taqnyat or unifonic. The sender name must be registered with CST for the bank's use case.
RINGSAYS_SMS_PROVIDER=taqnyat
RINGSAYS_SMS_SENDER_ID=RingSays
# Apple Push Notification service: token based key (.p8) from the PEOCIT Apple developer account.
RINGSAYS_APNS_KEY_ID=REPLACE_KEY_ID
RINGSAYS_APNS_TEAM_ID=REPLACE_TEAM
RINGSAYS_APNS_TOPIC=com.peocit.ringsays
RINGSAYS_APNS_SANDBOX=false
