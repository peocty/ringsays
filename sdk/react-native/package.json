{
  "name": "@ringsays/react-native-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Show and answer RingSays intents inside an organisation's own React Native app, with a Context Token.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-native": ">=0.74"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@ringsays|@noble|openapi-fetch))"
    ]
  },
  "dependencies": {
    "@ringsays/client": "workspace:*"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "expo": "57.0.26",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "5.8.3"
  }
}
