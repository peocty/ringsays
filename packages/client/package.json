{
  "name": "@ringsays/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Typed RingSays client API: device key, signed refresh, inbox, responses, preferences, Context Tokens.",
  "scripts": {
    "gen:api": "openapi-typescript ../../contracts/openapi/client.yaml -o src/schema.d.ts",
    "check:api-types": "openapi-typescript ../../contracts/openapi/client.yaml -o /tmp/ringsays-client-schema.d.ts && diff -q /tmp/ringsays-client-schema.d.ts src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "openapi-fetch": "0.14.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "openapi-typescript": "7.9.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
