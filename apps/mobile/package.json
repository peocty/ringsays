{
  "name": "@ringsays/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@ringsays/client": "workspace:*",
    "@ringsays/domain": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "expo": "57.0.26",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "25.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "16.0.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "5.8.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web --output-dir dist",
    "e2e": "playwright test"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@ringsays|@noble|openapi-fetch))"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  }
}
