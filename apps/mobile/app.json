{
  "expo": {
    "name": "RingSays",
    "slug": "ringsays",
    "scheme": "ringsays",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.peocit.ringsays",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": { "com.apple.developer.usernotifications.time-sensitive": true }
    },
    "android": {
      "package": "com.peocit.ringsays",
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#0f5c4d" }],
      ["expo-localization", { "supportsRTL": false, "supportedLocales": ["ar", "en"] }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiBase": "http://127.0.0.1:8000"
    }
  }
}
