{
  "name": "@ringsays/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../../contracts/openapi/admin.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:api-types": "openapi-typescript ../../contracts/openapi/admin.yaml -o /tmp/ringsays-admin-schema.d.ts && diff -q /tmp/ringsays-admin-schema.d.ts src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/ibm-plex-sans-arabic": "5.2.6",
    "@ringsays/domain": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "i18next": "25.5.3",
    "oidc-client-ts": "3.3.0",
    "openapi-fetch": "0.14.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "16.0.0",
    "react-router": "7.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.8.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "yaml": "2.8.0"
  }
}
